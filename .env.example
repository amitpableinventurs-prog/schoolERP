# ── Server ──────────────────────────────────────────────
PORT=5188
# Only on the live server (serves the built React app from /dist).
# NODE_ENV=production

# ── MongoDB ─────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/smart_campus_erp

# ── Login ───────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The first admin account is created from these on first start only.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@campus.local
ADMIN_PASSWORD=
# true = load demo students/batches/fees on an empty database.
SEED_DEMO=true

# ── AI ──────────────────────────────────────────────────
# AI_PROVIDER: gemini | openai | anthropic (empty = the first one with a key).
# Leave all keys empty to run without AI.
AI_PROVIDER=gemini
# Google Gemini - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded or out of quota.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# OpenAI - key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=
# Claude - key from https://platform.claude.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Claude only: retry declined requests on a fallback model. "off" to disable.
AI_FALLBACKS=on

# ── Automation ──────────────────────────────────────────
# How often (minutes) the scheduler checks for daily rules that are due.
AUTOMATION_TICK_MINUTES=15

# ── Platform: owner console, client domains, desktop licences ──
# You (the provider) log in at /owner with these. Change the password!
OWNER_NAME=Platform Owner
OWNER_EMAIL=
OWNER_PASSWORD=
# Records of client institutes and desktop installations.
PLATFORM_DB=smart_campus_platform
# Your own domain. Each client gets <code>.<PLATFORM_DOMAIN> automatically,
# plus any custom domain (erp.clientschool.com) you add in the owner console.
PLATFORM_DOMAIN=localhost
# Hosts that open the owner console and the main institute (default: localhost,
# 127.0.0.1, PLATFORM_DOMAIN, www./app.PLATFORM_DOMAIN).
# PLATFORM_HOSTS=
# What clients point their domain at - CNAME target and/or this server's IP.
# PLATFORM_CNAME_TARGET=app.myerp.in
# SERVER_IP=203.0.113.10
# Public address of this server; desktop apps activate and sync here.
PLATFORM_URL=http://localhost:5188
# A desktop app keeps working this many days without internet, then locks until it syncs.
OFFLINE_GRACE_DAYS=15
# Licence signing keys (auto-created; back them up - desktop builds embed the public key).
# LICENSE_KEY_DIR=keys
# Built installers served to clients.
# INSTALLER_DIR=desktop/release
